<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion><Nullable>disable</Nullable><ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Regression</AssemblyName>
    <!-- 不定义 BOSSRUSH_DEV：只有 run.py 去掉包裹的那两份按 Dev 口径编译，别的生产文件里的 Dev 区块引用 Unity。 -->
  </PropertyGroup>
  <ItemGroup>
    <!-- run.py 逐字抽出（只去掉首尾 #if BOSSRUSH_DEV / #endif，行号不变）。 -->
    <Compile Include="../../../Build/runtime-regressions/F3AutotestJudges/gen/AutotestJudges.cs" Link="Generated/AutotestJudges.cs" />
    <Compile Include="../../../Build/runtime-regressions/F3AutotestJudges/gen/SkyIslandStoryServiceAutotest.cs" Link="Generated/SkyIslandStoryServiceAutotest.cs" />
    <!-- 宿主替身：SavesSystem、Time、L10n 等沿用 SkyIslandStory 夹具；写入门替身（AutotestGateStub.cs）在本目录，默认拒绝。 -->
    <Compile Include="../SkyIslandStory/Stubs.cs" Link="Stubs/Stubs.cs" />
    <!-- 生产纯规则与共享存档引擎：与 SkyIslandValidationJudges 同一份清单。 -->
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandNoteBridge.cs" Link="Production/SkyIslandNoteBridge.cs" />
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandPointText.cs" Link="Production/SkyIslandPointText.cs" />
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandStoryRules.cs" Link="Production/SkyIslandStoryRules.cs" />
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandOfficialQuestTable.cs" Link="Production/SkyIslandOfficialQuestTable.cs" />
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandContent.cs" Link="Production/SkyIslandContent.cs" />
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandEnemyTier.cs" Link="Production/SkyIslandEnemyTier.cs" />
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandStoryCodec.cs" Link="Production/SkyIslandStoryCodec.cs" />
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandStoryService.cs" Link="Production/SkyIslandStoryService.cs" />
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandStoryResidentText.cs" Link="Production/SkyIslandStoryResidentText.cs" />
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandStorySaveRecovery.cs" Link="Production/SkyIslandStorySaveRecovery.cs" />
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandLetters.cs" Link="Production/SkyIslandLetters.cs" />
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandPuzzles.cs" Link="Production/SkyIslandPuzzles.cs" />
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandCrew.cs" Link="Production/SkyIslandCrew.cs" />
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandJournal.cs" Link="Production/SkyIslandJournal.cs" />
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandItemRules.cs" Link="Production/SkyIslandItemRules.cs" />
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandFieldcraftRules.cs" Link="Production/SkyIslandFieldcraftRules.cs" />
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandLights.cs" Link="Production/SkyIslandLights.cs" />
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandNight.cs" Link="Production/SkyIslandNight.cs" />
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandMosquitoRules.cs" Link="Production/SkyIslandMosquitoRules.cs" />
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandBounty.cs" Link="Production/SkyIslandBounty.cs" />
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandStormEchoRules.cs" Link="Production/SkyIslandStormEchoRules.cs" />
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandStormEchoReward.cs" Link="Production/SkyIslandStormEchoReward.cs" />
    <!-- 头目 / 岛主 R1 的档案表：剧情门面的手记白名单引用它。另一会话在建，文件还不在的签出里跳过（门面那一版也还没引用它）。 -->
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandBossRules.cs" Link="Production/SkyIslandBossRules.cs" Condition="Exists('../../../DebugAndTools/SkyIsland/SkyIslandBossRules.cs')" />
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandFrameProfile.cs" Link="Production/SkyIslandFrameProfile.cs" />
    <Compile Include="../../../DebugAndTools/SkyIsland/SkyIslandLootTables.cs" Link="Production/SkyIslandLootTables.cs" />
    <Compile Include="../../../Config/ConfigItemIds.cs" Link="Production/ConfigItemIds.cs" />
    <Compile Include="../../../Common/Lifecycle/BossRushSlotJsonStore.cs" Link="Production/BossRushSlotJsonStore.cs" />
    <Compile Include="../../../Common/Lifecycle/BossRushSaveCoordinatorEngine.cs" Link="Production/BossRushSaveCoordinatorEngine.cs" />
    <Compile Include="../../../Common/Data/BossRushJsonValue.cs" Link="Production/BossRushJsonValue.cs" />
    <Compile Include="../../../Common/Data/JsonDataRegistry.cs" Link="Production/JsonDataRegistry.cs" />
    <Compile Include="../../../Utilities/SimpleJsonHelper.cs" Link="Production/SimpleJsonHelper.cs" />
  </ItemGroup>
</Project>
