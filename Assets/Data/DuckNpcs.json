        "positiveItemTypeIds": [],
        "negativeItemTypeIds": [],
        "positiveBubbles": [
          "诶——这个我正好喜欢！",
          "谢谢你，我会好好收着的。",
          "你怎么知道我想要这个呀？"
        ],
        "negativeBubbles": [
          "……这个我大概用不上。",
          "唔，谢谢，不过下次不用麻烦了。"
        ],
        "normalBubbles": [
          "谢谢啦。",
          "收下了，心意我记着。"
        ],
        "dialogues": {
          "greeting": [
            {
              "minLevel": 0,
              "lines": [
                "又是你啊，今天外面还太平吗？",
                "站在这儿看久了，连风都认得我了。",
                "你回来了就好。"
              ]
            },
            {
              "minLevel": 5,
              "lines": [
                "回来啦？我一直在这儿等着呢。",
                "看到你没事，我这一天就算过好了。"
              ]
            },
            {
              "minLevel": 10,
              "lines": [
                "你走的每一趟我都在数。这趟也数完了。",
                "别的我不图，你平安回来就够了。"
              ]
            }
          ],
          "idle": [
            "外面的天色又变了。",
            "这地方待久了，倒也不觉得闷。",
            "……嗯？没什么，随便看看。"
          ],
          "afterGift": [
            "这个我收下了，真的谢谢你。",
            "你总是这样。"
          ],
          "levelUp": [
            "跟你说话越来越自在了。",
            "感觉我们……算是熟起来了吧？"
          ],
          "farewell": [
            "路上当心。",
            "早点回来。"
          ],
          "alreadyGifted": [
            "今天已经收过你的东西啦，够啦。"
          ],
          "alreadyGiftedPositive": [
            "今天你已经送过我了，我可不好意思再要。"
          ],
          "alreadyGiftedNormal": [
            "今天的份已经收过了。"
          ],
          "alreadyGiftedNegative": [
            "今天……就先这样吧。"
          ]
        },
        "marriedDialogues": {
          "dialogue_greeting_married": [
            "回来了？饭在锅里温着呢。",
            "今天也辛苦了。"
          ],
          "dialogue_idle_married": [
            "有你在，这地方才像个家。"
          ],
          "dialogue_farewell_married": [
            "去吧，我等你。"
          ],
          "dialogue_after_gift_married": [
            "都成一家人了还这么客气。"
          ],
          "gift_positive_married": [
            "你还记得我喜欢这个呀。"
          ],
          "gift_normal_married": [
            "收下了，谢谢你。"
          ]
        }
      }
